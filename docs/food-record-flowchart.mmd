flowchart TD
  A["用户想记录食物"] --> B{"入口选择"}

  B --> C1["拍照/相册识别"]
  B --> C2["文字描述记录"]
  B --> C3["手动搜索/自定义食物"]
  B --> C4["历史记录快速复用"]

  C1 --> D1["上传图片到 COS"]
  D1 --> D2["创建 analysis_task"]
  D2 --> D3["Worker 异步处理"]

  C2 --> D2

  D3 --> E1["视觉模型识别食物清单"]
  E1 --> E2["识别名称、包装线索、OCR、估重"]
  E2 --> E3["DB-first 营养回算"]

  E3 --> F1{"是否像包装食品?"}
  F1 -->|是| G1["包装库 resolver"]
  F1 -->|否| H1["标准营养库 resolver"]

  G1 --> G2{"包装 SKU 是否确定?"}
  G2 -->|条码/OCR净含量/强锚点唯一| G3["应用 packaged_food_library 营养和净含量"]
  G2 -->|只有候选或多规格不确定| G4["输出候选规格，结果页等待用户选择"]
  G2 -->|包装袋/SKU 全没命中，或弱命中不安全| H1

  H1 --> H2{"标准库是否命中?"}
  H2 -->|exact/alias/fuzzy/semantic| H3["按标准库每100g营养 + 估重回算"]
  H2 -->|标准库也未命中| I1["DeepSeek/LLM 营养兜底"]
  I1 --> I2{"兜底是否成功?"}
  I2 -->|成功| I3["deepseek_generated，并可补入普通营养库"]
  I2 -->|失败| I4["unresolved，但保存前必须拦截非真实零卡的0营养"]

  G3 --> J["组装分析结果"]
  G4 --> J
  H3 --> J
  I3 --> J
  I4 --> J

  J --> K["结果页展示"]
  K --> L{"用户是否编辑/选择规格?"}
  L -->|选择包装规格| L1["按所选 SKU 重新计算"]
  L -->|修改名称/重量/营养| L2["生成用户纠错 payload"]
  L -->|不修改| M["保存饮食记录"]

  L1 --> M
  L2 --> N["纠错任务 / 后端后处理"]
  N --> E3
  N --> M

  C3 --> S1["手动搜索标准库/包装库/个人库"]
  S1 --> S2["用户确认重量和营养"]
  S2 --> M

  C4 --> M

  M --> O1["写入 user_food_records.items"]
  O1 --> O2["保存包装证据、AI比例、营养来源"]
  O2 --> O3["首页/历史/分享图读取记录"]
  O3 --> P["用户看到本餐热量和 PFC"]

  F1 -. "[B/O] 包装食品触发判断" .-> X1["避免普通餐饮误进包装库"]
  G1 -. "[B/O] 包装 SKU 召回 benchmark" .-> X2["防错 SKU、错规格、弱 fuzzy 误命中"]
  G2 -. "[B/O] 多规格确认策略" .-> X3["候选不等于确定命中"]
  H1 -. "[B/O] 标准营养库召回 benchmark" .-> X4["品牌酸奶、口语名、单位短语不能 unresolved"]
  I1 -. "[B/O] LLM 兜底质量评估" .-> X5["包装库和标准库都未命中时必须兜底；不能生成离谱营养，也不能失败后保存 0"]
  M -. "[B/O] 保存前 0 营养门禁" .-> X6["非真实零卡食品不能入库为 0"]
  O3 -. "[B] 分享/历史一致性回归" .-> X7["展示值必须等于保存记录值"]
  G3 -. "[D] 包装库质量治理" .-> X8["active SKU 必须有净含量和合理营养"]
