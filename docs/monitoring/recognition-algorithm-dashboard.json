{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "foodlink-algorithm-audit",
  "title": "FoodLink 识别算法：执行与质量门禁",
  "description": "现有指标已在2026-10-17只读确认以otel_前缀导出。新增算法指标须部署后才有数据。完成率、格式通过率不等于识别/营养准确率。此文件未导入线上Grafana。",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "Asia/Shanghai",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "backend",
        "type": "query",
        "label": "后端环境",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(otel_food_link_food_analysis_total, exported_job)",
          "refId": "var-backend"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "food_link-backend-(main|dev)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "通用LLM封装调用（不含balanced主视觉）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage, status) (rate(otel_food_link_llm_calls_total{exported_job=~\"$backend\"}[5m]))",
          "legendFormat": "{{stage}}{{phase}}{{engine}}{{upstream}} {{gate}} {{outcome}}{{status}}{{condition}}{{task_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "执行统计不代表识别准确率。无数据保持No data，待部署的新序列不应解释为零问题。"
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "通用LLM封装 P95 秒数（不含balanced主视觉）",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(otel_food_link_llm_call_duration_seconds_bucket{exported_job=~\"$backend\"}[5m])))",
          "legendFormat": "{{stage}}{{phase}}{{engine}}{{upstream}} {{gate}} {{outcome}}{{status}}{{condition}}{{task_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "执行统计不代表识别准确率。无数据保持No data，待部署的新序列不应解释为零问题。"
    },
