{
  "expo": {
    "name": "智健食探",
    "slug": "foodlink-mobile",
    "scheme": "foodlink",
    "version": "4.6.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cn.healthymax.foodlink",
      "googleServicesFile": "./google-services.json",
      "versionCode": 64,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FBF5"
      }
    },
    "extra": {
      "apiBaseUrl": "https://dev.api.healthymax.cn",
      "shareBaseUrl": "https://healthymax.cn",
      "wechatAppId": "wx62da2262ae3ff06c",
      "eas": {
        "projectId": "454db191-c9ba-42f1-a486-f42535774c3b"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "photosPermission": "允许智健食探保存用户群二维码到相册。",
          "savePhotosPermission": "允许智健食探保存用户群二维码到相册。"
        }
      ]
    ],
    "owner": "jianwenma314s-team"
  }
}
