{
  "expo": {
    "name": "Food Link",
    "slug": "food-link-mobile",
    "scheme": "foodlink",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cn.healthymax.foodlink",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#00bc7d"
      }
    },
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:3010"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
