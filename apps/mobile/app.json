{
  "expo": {
    "name": "智健食探",
    "slug": "food-link-mobile",
    "scheme": "foodlink",
    "version": "0.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cn.healthymax.foodlink",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FBF5"
      }
    },
    "extra": {
      "apiBaseUrl": "http://127.0.0.1:3010",
      "eas": {
        "projectId": "09e22b2a-2d32-4d4c-bdd8-b663dae88fef"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "photo"
          ],
          "photosPermission": "允许智健食探保存用户群二维码到相册。",
          "savePhotosPermission": "允许智健食探保存用户群二维码到相册。"
        }
      ]
    ],
    "owner": "healthymax"
  }
}
