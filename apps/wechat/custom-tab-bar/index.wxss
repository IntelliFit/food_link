@font-face {
  font-family: "iconfont";
  src: url('data:font/truetype;charset=utf-8;base64,') format('truetype');
}

.iconfont {
  font-family: "iconfont" !important;
  font-style: normal;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.icon-shouye:before { content: "\e606"; }
.icon-weibiaoti1:before { content: "\e625"; }
.icon-quanzi:before { content: "\ee17"; }
.icon-user:before { content: "\e7ae"; }
.icon-kcal:before { content: "\e831"; }
.icon-paizhao-xianxing:before { content: "\e8d1"; }


/* 底部导航栏 - 优雅下凹曲线 + 悬浮按钮 + 底部阴影 */
.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: transparent;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  padding-left: 20rpx;
  padding-right: 20rpx;
  z-index: 999;
}

/* 底部导航背景；中心拍照按钮使用下方独立的正常流布局。
*/
.custom-tab-bar::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100%;  
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20750%2096%27%20preserveAspectRatio%3D%27none%27%3E%3Cpath%20d%3D%27M0%2C0%20L265%2C0%20C295%2C0%20315%2C10%20330%2C30%20C345%2C44%20360%2C44%20375%2C44%20C390%2C44%20405%2C44%20420%2C30%20C435%2C10%20455%2C0%20485%2C0%20L750%2C0%20L750%2C96%20L0%2C96%20Z%27%20fill%3D%27%23ffffff%27/%3E%3C/svg%3E");
  background-size: 100% 100%;
  background-repeat: no-repeat;
  filter: drop-shadow(0 -8rpx 28rpx rgba(0, 0, 0, 0.22));
  z-index: -1;
  pointer-events: none;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 15rpx;
  transition: all 0.2s ease;
  position: relative;
  height: 110rpx;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.tab-item.selected .tab-text {
  color: #5cb896;
  font-weight: 500;
}

.icon-wrapper {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.tab-icon {
  font-size: 42rpx;
  line-height: 1;
  color: #b0b0b0;
  transition: all 0.2s ease;
}

.tab-item.selected .tab-icon {
  color: #5cb896;
}

.tab-item.selected .icon-wrapper {
  transform: scale(1.05);
}

.center-task-badge {
  position: absolute;
  z-index: 12;
  top: -8rpx;
  right: -6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 4rpx solid #fff;
  border-radius: 24rpx;
}

.center-task-badge--waiting {
  min-width: 42rpx;
  height: 42rpx;
  padding: 0 8rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.center-task-badge--recognizing {
  width: 30rpx;
  height: 30rpx;
  background: #60a5fa;
  animation: center-task-badge-pulse 1.25s ease-in-out infinite;
}

@keyframes center-task-badge-pulse {
  0%, 100% { opacity: 0.7; transform: scale(0.86); }
  50% { opacity: 1; transform: scale(1.08); }
}

.custom-tab-bar--dark .center-task-badge {
  border-color: #1a2220;
}

@keyframes center-opening-spin {
  to {
    transform: rotate(360deg);
  }
}

/* 我的按钮上的红点提醒 */
.profile-icon-wrapper {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 52rpx;
}

.tab-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 20rpx;
  height: 20rpx;
  background: #ef4444;
  border-radius: 50%;
  z-index: 10;
}

/* ===== 文字样式 ===== */
.tab-text {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1;
  transition: all 0.2s ease;
}

/* 隐藏状态 */
.custom-tab-bar.hidden {
  display: none;
}

.custom-tab-bar.hidden::before {
  display: none;
}

/* 深色主题：与页面 `fl-page-theme-root--dark` 协调 */
.custom-tab-bar--dark::before {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20750%2096%27%20preserveAspectRatio%3D%27none%27%3E%3Cpath%20d%3D%27M0%2C0%20L265%2C0%20C295%2C0%20315%2C10%20330%2C30%20C345%2C44%20360%2C44%20375%2C44%20C390%2C44%20405%2C44%20420%2C30%20C435%2C10%20455%2C0%20485%2C0%20L750%2C0%20L750%2C96%20L0%2C96%20Z%27%20fill%3D%27%231a2220%27/%3E%3C/svg%3E");
  filter: drop-shadow(0 -8rpx 28rpx rgba(0, 0, 0, 0.45));
}

.custom-tab-bar--dark .tab-icon {
  color: #6b7280;
}

.custom-tab-bar--dark .tab-item.selected .tab-icon {
  color: #7dd3b0;
}

.custom-tab-bar--dark .tab-text {
  color: #6b7280;
}

.custom-tab-bar--dark .tab-item.selected .tab-text {
  color: #7dd3b0;
}

/* 全局养生模式：跨 Tab 保持深墨绿底栏、暖米白中心按钮与低饱和金色选中态 */
.custom-tab-bar--wellness::before {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20viewBox%3D%270%200%20750%2096%27%20preserveAspectRatio%3D%27none%27%3E%3Cpath%20d%3D%27M0%2C0%20L265%2C0%20C295%2C0%20315%2C10%20330%2C30%20C345%2C44%20360%2C44%20375%2C44%20C390%2C44%20405%2C44%20420%2C30%20C435%2C10%20455%2C0%20485%2C0%20L750%2C0%20L750%2C96%20L0%2C96%20Z%27%20fill%3D%27%2315382a%27/%3E%3C/svg%3E");
  filter: drop-shadow(0 -8rpx 28rpx rgba(8, 32, 23, 0.42));
}

.custom-tab-bar--wellness .tab-icon,
.custom-tab-bar--wellness .tab-text {
  color: #b7c6b8;
}

.custom-tab-bar--wellness .tab-item.selected .tab-icon,
.custom-tab-bar--wellness .tab-item.selected .tab-text {
  color: #eed6a2;
}

/* Wellness navigation shares the ink / paper theme. */
.custom-tab-bar--wellness::before { background: #222; border-color: #444; }
.custom-tab-bar--wellness .tab-icon,
.custom-tab-bar--wellness .tab-text { color: #aaa; }
.custom-tab-bar--wellness .tab-item.selected .tab-icon,
.custom-tab-bar--wellness .tab-item.selected .tab-text { color: #fff; }
/* Approved ink theme: white paper navigation and an actual Taiji photo control. */
.custom-tab-bar.custom-tab-bar--wellness::before { background: #f7f7f4; background-image: none; filter: none; border-top: 1rpx solid #ccc; }
.custom-tab-bar.custom-tab-bar--wellness .tab-icon,
.custom-tab-bar.custom-tab-bar--wellness .tab-text { color: #666; }
.custom-tab-bar.custom-tab-bar--wellness .tab-item.selected .tab-icon,
.custom-tab-bar.custom-tab-bar--wellness .tab-item.selected .tab-text { color: #111; }
.custom-tab-bar.custom-tab-bar--wellness .tab-text { font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif; font-size: 24rpx; font-weight: 500; line-height: 1.4; }

/* Balanced mode: each visual theme owns the navigation material and capture control. */
.custom-tab-bar[class*="custom-tab-bar--theme-"]::before {
  background-image: none;
  border-top: 1rpx solid transparent;
  transition: background .45s ease, border-color .45s ease, filter .45s ease;
}

.custom-tab-bar[class*="custom-tab-bar--theme-"] .tab-text {
  font-weight: 650;
  letter-spacing: 1rpx;
}

/* 01 澄明秩序：黑白栅格与荧光黄绿操作块。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order::before {
  background: #f8f8f2;
  border-top: 4rpx solid #111 !important;
  filter: drop-shadow(0 -8rpx 0 #c8ff00) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order .tab-text { color: #73736e; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order .tab-item.selected .tab-text { color: #111; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order .tab-item.selected::after {
  content: ''; position: absolute; left: 24%; right: 24%; bottom: 12rpx; height: 7rpx; background: #c8ff00;
}

/* 02 自然共生：植物纸、林叶绿与种荚形入口。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis::before {
  background: #f3efe2;
  border-top-color: #718b71 !important;
  filter: drop-shadow(0 -8rpx 24rpx rgba(49, 83, 58, .18)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis .tab-text { color: #7d806f; font-family: 'Kaiti SC', STKaiti, KaiTi, serif; }
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis .tab-item.selected .tab-text { color: #376b4d; }

/* 03 东方雅集：宣纸底栏与直立黑金印钮。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon::before {
  background: #eee9dc;
  border-top-color: #292822 !important;
  filter: drop-shadow(0 -5rpx 18rpx rgba(32, 31, 27, .18)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon .tab-text { color: #777264; font-family: 'Songti SC', STSong, SimSun, serif; }
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon .tab-item.selected .tab-text { color: #9f3328; }

/* 04 现代艺廊：原色、硬边和展签构图。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery::before {
  background: #fffefa;
  border-top: 5rpx solid #111 !important;
  filter: drop-shadow(0 -9rpx 0 #f2c500) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-text { color: #111; font-weight: 850; }
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(1).selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(1).selected .tab-text,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(4).selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(4).selected .tab-text { color: #173eb5; }
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(2).selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(2).selected .tab-text,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(5).selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery .tab-item:nth-child(5).selected .tab-text { color: #e33b25; }

/* 05 微缩世界：木质地台与青铜工具钮。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world::before {
  background: #d6bd91;
  border-top: 5rpx solid #674c37 !important;
  filter: drop-shadow(0 -10rpx 0 #9b7651) drop-shadow(0 -14rpx 20rpx rgba(74, 51, 30, .22)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world .tab-text { color: #6b5540; }
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world .tab-item.selected .tab-text { color: #176d83; }

/* 06 绘本陪伴：深蓝布脊和纸页签。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion::before {
  background: #f0dfbf;
  border-top: 5rpx solid #263746 !important;
  filter: drop-shadow(0 -8rpx 20rpx rgba(53, 38, 28, .24)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-text { color: #6b5a4b; font-family: 'Kaiti SC', STKaiti, KaiTi, serif; }
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-item.selected .tab-text { color: #a75536; }

/* 07 清朗关怀：高对比、大触控、明确状态。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care::before {
  background: #fff;
  border-top: 5rpx solid #071b12 !important;
  filter: none !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-item { gap: 8rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-icon { color: #515b55; font-size: 45rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-text { color: #39433e; font-size: 24rpx; font-weight: 850; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-item.selected .tab-text { color: #005b38; }

/* 08 水之道：深水玻璃、冷光水线与暖铜焦点。 */
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water::before {
  background: #07121b;
  border-top-color: rgba(142, 213, 237, .46) !important;
  filter: drop-shadow(0 -10rpx 28rpx rgba(0, 0, 0, .5)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-text { color: #77919d; }
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item.selected .tab-text { color: #e8edf0; }
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item.selected::after {
  content: ''; position: absolute; left: 36%; right: 36%; bottom: 11rpx; height: 4rpx; background: #d06f3f; border-radius: 999rpx; box-shadow: 0 0 14rpx #d06f3f;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .center-task-badge { border-color: #07121b; }
/* Match the dark literary chapter artwork across the native navigation surface. */
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion::before { background: #10222a; border-top: 1rpx solid #52605d !important; }
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-text { color: #b6afa1; }
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-item.selected .tab-icon,
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion .tab-item.selected .tab-text { color: #efd292; }

/* Balanced themes keep capture in the same navigation rhythm as the four tabs. */
.custom-tab-bar--balanced {
  --nav-paper: #fafaf7;
  --nav-ink: #222;
  --nav-muted: #666;
  --nav-accent: #c8ff00;
  --nav-line: #b9b9b1;
  --nav-radius: 0rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
}
.custom-tab-bar--balanced::before {
  background: var(--nav-paper) !important;
  border-top: 1rpx solid var(--nav-line) !important;
  border-radius: var(--nav-radius) var(--nav-radius) 0 0;
  filter: none !important;
}
.custom-tab-bar--balanced .tab-item { height: 112rpx; justify-content: center; gap: 9rpx; padding-bottom: 0; }
.custom-tab-bar--balanced .tab-icon { color: var(--nav-muted); font-size: 39rpx; }
.custom-tab-bar--balanced .tab-text { color: var(--nav-muted); font-size: 23rpx; }
.custom-tab-bar--balanced .tab-item.selected .tab-icon, .custom-tab-bar--balanced .tab-item.selected .tab-text { color: var(--nav-ink); }
.custom-tab-bar--balanced .tab-item.selected .icon-wrapper { transform: none; }
.custom-tab-bar--balanced .tab-item.selected::after { background: var(--nav-accent); height: 3rpx; left: 30%; right: 30%; bottom: 5rpx; box-shadow: none; }
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis { --nav-paper: #f4f1e2; --nav-ink: #254830; --nav-muted: #71816c; --nav-accent: #56795b; --nav-line: #afbaa0; --nav-radius: 18rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon { --nav-paper: #eee7d8; --nav-ink: #292d28; --nav-muted: #7b7d71; --nav-accent: #98734b; --nav-line: #9e9582; }
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery { --nav-paper: #f4eddc; --nav-ink: #b0261b; --nav-muted: #292929; --nav-accent: #1748aa; --nav-line: #111; }
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world { --nav-paper: #e5d1b0; --nav-ink: #493321; --nav-muted: #82715c; --nav-accent: #493321; --nav-line: #9e8059; --nav-radius: 18rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion { --nav-paper: #10222a; --nav-ink: #efd292; --nav-muted: #b6afa1; --nav-accent: #efd292; --nav-line: #52605d; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care { --nav-paper: #fff; --nav-ink: #005b38; --nav-muted: #53605a; --nav-accent: #005b38; --nav-line: #d2dfd6; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-text { font-size: 27rpx; font-weight: 600; }
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water { --nav-paper: #07121b; --nav-ink: #e6f1f4; --nav-muted: #829eaa; --nav-accent: #d2a482; --nav-line: #455e6b; --nav-radius: 22rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water::before {
  background: rgba(5, 18, 27, .92) !important;
  border-top-color: rgba(142, 213, 237, .44) !important;
  filter: drop-shadow(0 -10rpx 28rpx rgba(0, 0, 0, .48)) !important;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item.selected::after { background: #aee9f7; box-shadow: 0 0 14rpx rgba(136, 220, 240, .75); }
.custom-tab-bar--balanced.custom-tab-bar--dark { --nav-paper: #101716; --nav-ink: #f1f4ef; --nav-muted: #a4b0aa; --nav-line: #40504a; }

/* Capture has one upright layout. Theme variables change its material only. */
.custom-tab-bar {
  --capture-width: 92rpx;
  --capture-height: 88rpx;
  --capture-radius: 24rpx;
  --capture-surface: #397e66;
  --capture-ink: #fff;
  --capture-label: #53605a;
  --capture-outline: #28624e;
  --capture-border: 2rpx;
  --capture-shadow: 0 5rpx 0 #28624e;
  --capture-inner-line: transparent;
  --capture-inner-style: solid;
  --capture-glint: transparent;
}
.custom-tab-bar .tab-item.center-item {
  z-index: 2;
  height: 160rpx;
  justify-content: flex-end;
  gap: 6rpx;
  padding-bottom: 20rpx;
  overflow: visible;
}
.custom-tab-bar .tab-item.center-item .icon-wrapper {
  width: 108rpx;
  height: 100rpx;
  flex: 0 0 100rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  transform: none;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
}
.custom-tab-bar .tab-item.center-item .center-icon-wrapper {
  position: relative;
  left: auto;
  top: auto;
  width: var(--capture-width);
  height: var(--capture-height);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  transform: none;
  color: var(--capture-ink);
  background: var(--capture-surface);
  border: var(--capture-border) solid var(--capture-outline);
  border-radius: var(--capture-radius);
  box-shadow: var(--capture-shadow);
  overflow: visible;
  transition: filter .15s ease;
}
.custom-tab-bar .center-icon-wrapper::before {
  content: '';
  position: absolute;
  inset: 7rpx;
  border: 1rpx var(--capture-inner-style) var(--capture-inner-line);
  border-radius: inherit;
  pointer-events: none;
}
.custom-tab-bar .center-icon-wrapper::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 10rpx;
  width: 32rpx;
  height: 7rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--capture-glint);
  pointer-events: none;
}
.custom-tab-bar .tab-item.center-item .tab-text {
  display: block;
  height: 30rpx;
  flex: 0 0 30rpx;
  margin: 0;
  font-size: 23rpx;
  line-height: 30rpx;
  letter-spacing: 1rpx;
  text-align: center;
  color: var(--capture-label);
  transform: none;
  transition: none;
}
.custom-tab-bar .center-item:active .center-icon-wrapper { filter: brightness(.92); }

/* Native navigation does not inherit the page's small-copy typography. */
.custom-tab-bar.custom-tab-bar .tab-item .tab-text {
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
  letter-spacing: 0;
}
.custom-tab-bar.custom-tab-bar .tab-item.center-item .tab-text {
  height: 34rpx;
  flex-basis: 34rpx;
}
.custom-tab-bar.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .tab-item .tab-text {
  font-size: 26rpx;
}
.custom-tab-bar.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item .tab-text {
  color: #c4d9e2;
}
.custom-tab-bar.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water .tab-item.selected .tab-text {
  color: #effaff;
}

/* Draw the camera on a fixed axis instead of counter-rotating a font glyph. */
.capture-camera {
  position: relative;
  z-index: 1;
  width: 52rpx;
  height: 44rpx;
  flex-shrink: 0;
  color: var(--capture-ink);
  transform: none;
  pointer-events: none;
}
.capture-camera__body {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: 3rpx;
  height: 34rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--capture-ink);
  border-radius: 7rpx;
}
.capture-camera__body::before {
  content: '';
  position: absolute;
  left: 6rpx;
  top: -9rpx;
  width: 18rpx;
  height: 9rpx;
  box-sizing: border-box;
  background: var(--capture-head-fill, var(--capture-surface));
  border: 4rpx solid var(--capture-ink);
  border-bottom: 0;
  border-radius: 5rpx 5rpx 0 0;
}
.capture-camera__lens {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 17rpx;
  height: 17rpx;
  box-sizing: border-box;
  border: 4rpx solid var(--capture-ink);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.capture-camera__flash {
  position: absolute;
  right: 5rpx;
  top: 5rpx;
  width: 4rpx;
  height: 4rpx;
  background: var(--capture-ink);
  border-radius: 50%;
}
.custom-tab-bar .center-opening-spinner {
  position: relative;
  z-index: 2;
  width: 38rpx;
  height: 38rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  color: var(--capture-ink);
  border: 4rpx solid currentColor;
  border-bottom-color: transparent;
  border-radius: 50%;
  animation: center-opening-spin .7s linear infinite;
}

/* 01: an aligned grid key with a centered black base. */
.custom-tab-bar--balanced.custom-tab-bar--theme-clarity-order {
  --capture-radius: 24rpx; --capture-surface: #c8ff00; --capture-ink: #111;
  --capture-label: #111;
  --capture-outline: #111; --capture-border: 3rpx; --capture-shadow: 0 5rpx 0 #111;
}
/* 02: a leaf-shaped ceramic seal on the paper navigation. */
.custom-tab-bar--balanced.custom-tab-bar--theme-natural-symbiosis {
  --capture-width: 98rpx; --capture-radius: 42rpx 16rpx 42rpx 16rpx;
  --capture-surface: #376b4d; --capture-ink: #fffdf6; --capture-outline: #e3e7d1;
  --capture-label: #376b4d;
  --capture-border: 3rpx; --capture-shadow: 0 5rpx 0 #9b805e; --capture-inner-line: #c9dabc80;
}
/* 03: a straight lacquer seal, with an inset gold frame. */
.custom-tab-bar--balanced.custom-tab-bar--theme-eastern-salon {
  --capture-width: 88rpx; --capture-radius: 24rpx; --capture-surface: #20231b;
  --capture-ink: #f2dbab; --capture-outline: #ba9b60; --capture-inner-line: #ba9b60;
  --capture-label: #5f5138;
  --capture-shadow: 0 5rpx 0 #817044;
}
/* 04: a red exhibition key, grounded on a blue plinth. */
.custom-tab-bar--balanced.custom-tab-bar--theme-modern-gallery {
  --capture-radius: 24rpx; --capture-surface: #b92d22; --capture-ink: #fff;
  --capture-label: #b92d22;
  --capture-outline: #111; --capture-border: 3rpx; --capture-shadow: 0 6rpx 0 #173eb5;
}
/* 05: a turquoise tool set into a wooden frame. */
.custom-tab-bar--balanced.custom-tab-bar--theme-miniature-world {
  --capture-width: 98rpx; --capture-radius: 24rpx; --capture-surface: #236c81;
  --capture-ink: #fff7e8; --capture-outline: #745535; --capture-border: 4rpx;
  --capture-label: #493321;
  --capture-inner-line: #d9bf8e; --capture-shadow: 0 6rpx 0 #745535;
}
/* 06: a stitched, upright bookplate. */
.custom-tab-bar--balanced.custom-tab-bar--theme-picturebook-companion {
  --capture-radius: 24rpx; --capture-surface: #ecd8b0; --capture-ink: #213731;
  --capture-outline: #6d5139; --capture-inner-line: #8e7350; --capture-inner-style: dashed;
  --capture-label: #eed3a1;
  --capture-shadow: 0 5rpx 0 #6d5139;
}
/* 07: a large high-contrast control with no decorative shadow. */
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care {
  --capture-width: 104rpx; --capture-radius: 26rpx; --capture-surface: #005b38;
  --capture-ink: #fff; --capture-outline: #fff; --capture-border: 3rpx; --capture-shadow: none;
  --capture-label: #005b38;
}
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .capture-camera { width: 60rpx; height: 48rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .capture-camera__body { height: 38rpx; }
.custom-tab-bar--balanced.custom-tab-bar--theme-clear-care .center-item .tab-text { font-size: 27rpx; }
/* 08: retain the water-glass material while centering the control and lens. */
.custom-tab-bar--balanced.custom-tab-bar--theme-way-of-water {
  --capture-width: 96rpx; --capture-height: 96rpx; --capture-radius: 50%;
  --capture-surface: radial-gradient(circle at 50% 24%, #789ca8, #285a70 46%, #092334 85%);
  --capture-head-fill: #44788b; --capture-ink: #eefbff; --capture-outline: #aee2f1c7;
  --capture-label: #eefbff;
  --capture-inner-line: #c6f1fc73; --capture-glint: #e7fbff80;
  --capture-shadow: inset 0 0 24rpx #caf3ff38, 0 0 0 5rpx #5db4cd1f, 0 5rpx 16rpx #00000070;
}
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-clarity-order { --capture-label: #c8ff00; }
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-natural-symbiosis { --capture-outline: #b8cdb0; --capture-label: #bfd7b4; }
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-eastern-salon { --capture-label: #dfcda9; }
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-modern-gallery { --capture-label: #ffb6aa; }
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-miniature-world { --capture-outline: #b79566; --capture-label: #e8cda3; }
.custom-tab-bar--balanced.custom-tab-bar--dark.custom-tab-bar--theme-clear-care { --capture-outline: #b8e6c7; --capture-label: #b8e6c7; }

/* Paper / Taiji remains independent of the saved balanced theme. */
.custom-tab-bar.custom-tab-bar--wellness {
  --capture-width: 96rpx; --capture-height: 96rpx; --capture-radius: 50%;
  --capture-surface: #fafaf7; --capture-head-fill: #fafaf7; --capture-ink: #222;
  --capture-label: #222;
  --capture-outline: #777; --capture-inner-line: #b9b9b3;
  --capture-shadow: 0 4rpx 0 #d2d2ca; --capture-glint: transparent;
}
.custom-tab-bar.custom-tab-bar--wellness .tab-item.center-item .tab-text {
  height: 34rpx;
  flex-basis: 34rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}
.custom-tab-bar .center-taiji {
  position: absolute;
  left: 7%; top: 7%; width: 86%; height: 86%;
  border-radius: 50%;
  opacity: .16;
  pointer-events: none;
}
