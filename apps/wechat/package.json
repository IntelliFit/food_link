{
  "name": "@food-link/wechat",
  "version": "3.0.2",
  "private": true,
  "description": "Food Link WeChat Mini Program",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "new": "taro new",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "jest --config ./jest.config.cjs",
    "test:watch": "jest --config ./jest.config.cjs --watch",
    "test:coverage": "jest --config ./jest.config.cjs --coverage",
    "weapp:size": "node ../../scripts/check-weapp-package-size.mjs",
    "build:weapp": "cross-env NODE_ENV=production taro build --type weapp && npm run weapp:size",
    "build:weapp:preview": "cross-env NODE_ENV=production taro build --type weapp && npm run weapp:size",
    "build:weapp:release": "cross-env NODE_ENV=production taro build --type weapp && npm run weapp:size",
    "build:weapp:debug": "cross-env NODE_ENV=development taro build --type weapp --no-check",
    "build:weapp:e2e": "cross-env NODE_ENV=development taro build --type weapp --no-check",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:weapp": "cross-env NODE_ENV=development taro build --type weapp --watch --no-check",
    "dev:weapp:preview": "cross-env NODE_ENV=development taro build --type weapp --watch --no-check",
    "dev:weapp:online": "cross-env NODE_ENV=production taro build --type weapp --watch --no-check",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "iconfont": "iconfont-taro"
  }
}
