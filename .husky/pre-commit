#!/bin/sh
# 提交前清理根目录下的临时文件
cd "$(git rev-parse --show-toplevel)" || exit 1

# 删除根目录下的临时文件（不包括子目录）
# *.png - 调试截图
# *.html - 预览文件
# *.py - 调试脚本
# *.js - 根目录下的临时 JS 文件
TRACKED_TEMP_FILES="$(git ls-files -- '*.png' '*.html' '*.py' '*.js' | grep -v '/' || true)"
find . -maxdepth 1 \( -name "*.png" -o -name "*.html" -o -name "*.py" -o -name "*.js" \) -type f -delete

# 只暂存被清理的已跟踪根目录临时文件，禁止把其他未暂存业务改动带进本次提交。
if [ -n "$TRACKED_TEMP_FILES" ]; then
  printf '%s\n' "$TRACKED_TEMP_FILES" | xargs git add -u --
fi

# 对本次暂存内容执行确定性的提交前审查；语义级代码审查由每日 foodlink-pr-review 任务完成。
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMRD)"
EXISTING_STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

echo "[pre-commit] 检查暂存 diff..."
git diff --cached --check || exit 1

SENSITIVE_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '(^|/)\.env($|\.)|(^|/)(credentials|secrets)(/|$)' | grep -v -E '\.env\.example$' || true)"
if [ -n "$SENSITIVE_FILES" ]; then
  echo "[pre-commit] 拒绝提交疑似敏感文件："
  printf '%s\n' "$SENSITIVE_FILES"
  exit 1
fi

# 后续所有构建、格式化与测试都在 Git 暂存区导出的快照中执行，避免未暂存内容掩盖提交问题。
SNAPSHOT_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/foodlink-precommit.XXXXXX")"
cleanup_snapshot() {
  case "$SNAPSHOT_ROOT" in
    */foodlink-precommit.*)
      if command -v cygpath >/dev/null 2>&1 && command -v powershell.exe >/dev/null 2>&1; then
        for DEPENDENCY_LINK in "$SNAPSHOT_ROOT/node_modules" "$SNAPSHOT_ROOT/admin/node_modules"; do
          DEPENDENCY_LINK_WINDOWS="$(cygpath -aw "$DEPENDENCY_LINK")"
          FOODLINK_LINK_TARGET="$DEPENDENCY_LINK_WINDOWS" powershell.exe -NoLogo -NoProfile -NonInteractive -Command \
            '$path = $env:FOODLINK_LINK_TARGET; if (Test-Path -LiteralPath $path) { $item = Get-Item -LiteralPath $path -Force; if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) { [System.IO.Directory]::Delete($item.FullName) } }' \
            >/dev/null 2>&1 || true
        done
      fi
      find "$SNAPSHOT_ROOT" -depth -delete 2>/dev/null || true
      ;;
  esac
}
trap cleanup_snapshot EXIT HUP INT TERM
git show :scripts/export-staged-snapshot.sh | sh -s -- "$SNAPSHOT_ROOT" || exit 1

link_dependency_directory() {
  SOURCE_DIRECTORY="$1"
  TARGET_DIRECTORY="$2"
  if command -v cygpath >/dev/null 2>&1 && command -v powershell.exe >/dev/null 2>&1; then
    SOURCE_DIRECTORY_WINDOWS="$(cygpath -aw "$SOURCE_DIRECTORY")"
    TARGET_DIRECTORY_WINDOWS="$(cygpath -aw "$TARGET_DIRECTORY")"
    FOODLINK_LINK_SOURCE="$SOURCE_DIRECTORY_WINDOWS" \
      FOODLINK_LINK_TARGET="$TARGET_DIRECTORY_WINDOWS" \
      powershell.exe -NoLogo -NoProfile -NonInteractive -Command \
      '$ErrorActionPreference = "Stop"; New-Item -ItemType Junction -Path $env:FOODLINK_LINK_TARGET -Target $env:FOODLINK_LINK_SOURCE | Out-Null' && return 0
  fi
  if ln -s "$SOURCE_DIRECTORY" "$TARGET_DIRECTORY" 2>/dev/null; then
    return 0
  fi
  echo "[pre-commit] 无法挂载依赖目录：$SOURCE_DIRECTORY -> $TARGET_DIRECTORY"
  return 1
}

echo "[pre-commit] Hook 语法检查..."
sh -n "$SNAPSHOT_ROOT/.husky/pre-commit" || exit 1
HOOK_TOOL_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^\.husky/pre-commit$|^scripts/export-staged-snapshot\.(sh|test\.mjs)$' || true)"
if [ -n "$HOOK_TOOL_FILES" ]; then
  echo "[pre-commit] 暂存快照导出场景测试..."
  (cd "$SNAPSHOT_ROOT" && node --test scripts/export-staged-snapshot.test.mjs) || exit 1
fi

WECHAT_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^apps/wechat/(src|tests|config)/|^apps/wechat/(package\.json|jest\.config\.[cm]?js|tsconfig(\.[^.]+)?\.json|\.eslintrc(\..+)?)$|^(package\.json|package-lock\.json|jest\.config\.[cm]?js|tsconfig(\.[^.]+)?\.json|\.eslintrc(\..+)?)$' || true)"
if [ -n "$WECHAT_FILES" ] && [ -d node_modules ]; then
  link_dependency_directory "$(pwd)/node_modules" "$SNAPSHOT_ROOT/node_modules" || exit 1
fi
if [ -n "$WECHAT_FILES" ]; then
  echo "[pre-commit] 微信端 TypeScript 检查..."
  (cd "$SNAPSHOT_ROOT" && npm run typecheck) || exit 1

  WECHAT_LINT_FILES="$(printf '%s\n' "$EXISTING_STAGED_FILES" | grep -E '^apps/wechat/(src|tests|config)/.*\.(ts|tsx)$' || true)"
  WECHAT_LINT_CONFIG_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^apps/wechat/\.eslintrc(\..+)?$|^\.eslintrc(\..+)?$' || true)"
  if [ -n "$WECHAT_LINT_CONFIG_FILES" ]; then
    echo "[pre-commit] 微信端全量 ESLint 检查..."
    (cd "$SNAPSHOT_ROOT" && npm run lint) || exit 1
  elif [ -n "$WECHAT_LINT_FILES" ]; then
    echo "[pre-commit] 微信端 ESLint 检查..."
    (cd "$SNAPSHOT_ROOT" && printf '%s\n' "$WECHAT_LINT_FILES" | xargs npx eslint --max-warnings 0) || exit 1
  fi

  echo "[pre-commit] 微信端测试..."
  (cd "$SNAPSHOT_ROOT" && npm test -- --runInBand) || exit 1
fi

ADMIN_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^admin/|^(package\.json|package-lock\.json)$' || true)"
if [ -n "$ADMIN_FILES" ]; then
  if [ -d admin/node_modules ]; then
    link_dependency_directory "$(pwd)/admin/node_modules" "$SNAPSHOT_ROOT/admin/node_modules" || exit 1
  fi

  echo "[pre-commit] Admin 类型与构建检查..."
  (cd "$SNAPSHOT_ROOT" && npm --prefix admin run build) || exit 1
fi

GO_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^backend/.*\.go$' || true)"
GO_TRIGGER_FILES="$(printf '%s\n' "$STAGED_FILES" | grep -E '^backend/.*\.go$|^backend/go\.(mod|sum)$' || true)"
if [ -n "$GO_TRIGGER_FILES" ]; then
  echo "[pre-commit] Go 格式检查..."
  GO_FORMAT_FILES="$(printf '%s\n' "$EXISTING_STAGED_FILES" | grep -E '^backend/.*\.go$' || true)"
  UNFORMATTED=""
  if [ -n "$GO_FORMAT_FILES" ]; then
    UNFORMATTED="$(cd "$SNAPSHOT_ROOT" && printf '%s\n' "$GO_FORMAT_FILES" | xargs gofmt -l)"
  fi
  if [ -n "$UNFORMATTED" ]; then
    echo "[pre-commit] 以下 Go 文件尚未 gofmt："
    printf '%s\n' "$UNFORMATTED"
    exit 1
  fi

  echo "[pre-commit] Go 相关包测试..."
  (
    cd "$SNAPSHOT_ROOT/backend" || exit 1
    GO_PACKAGES=""
    GO_TEST_ALL=0
    if printf '%s\n' "$STAGED_FILES" | grep -Eq '^backend/go\.(mod|sum)$'; then
      GO_TEST_ALL=1
    fi
    for GO_FILE in $GO_FILES; do
      GO_RELATIVE="${GO_FILE#backend/}"
      GO_DIR="${GO_RELATIVE%/*}"
      if [ "$GO_DIR" = "$GO_RELATIVE" ]; then
        GO_DIR="."
      fi
      if [ "$GO_DIR" = "." ] || [ -d "$GO_DIR" ]; then
        GO_PACKAGES="$GO_PACKAGES ./$GO_DIR"
      else
        # 整个 Go 包被删除时，原目录已不存在；运行全量测试覆盖依赖关系。
        GO_TEST_ALL=1
      fi
    done
    if [ "$GO_TEST_ALL" -eq 1 ]; then
      go test -p 1 ./...
    else
      GO_PACKAGES="$(printf '%s\n' $GO_PACKAGES | sort -u | tr '\n' ' ')"
      # shellcheck disable=SC2086
      go test -p 1 $GO_PACKAGES
    fi
  ) || exit 1
fi

echo "[pre-commit] 审查通过。"
