# 复制为 .env.development / .env.production 后按需修改（二者均被 gitignore，勿提交）
# 详见 docs/api-url-configuration.md

# --- 小程序 API（按微信 envVersion 运行时选择，构建时注入）---
# 正式版 release → 正式 API
TARO_APP_API_BASE_URL_RELEASE=https://api.healthymax.cn
# 体验版 trial → 开发 API
TARO_APP_API_BASE_URL_TRIAL=https://dev.api.healthymax.cn
# 开发者工具 / 开发版 develop → 本地后端
TARO_APP_API_BASE_URL_DEVELOP=http://127.0.0.1:3010

# 可选：强制所有 envVersion 使用同一 API（e2e、真机联调局域网 IP 等）
# TARO_APP_API_BASE_URL_OVERRIDE=http://127.0.0.1:3010
# 兼容旧变量名，等价于 OVERRIDE
# TARO_APP_API_BASE_URL=http://127.0.0.1:3010

# --- 其他小程序构建变量 ---
# TARO_APP_ID=你的小程序AppId
TARO_APP_EXPIRY_SUBSCRIBE_TEMPLATE_ID=
TARO_APP_ANALYSIS_SUBSCRIBE_TEMPLATE_ID=
TARO_APP_ICON_CDN_BASE_URL=https://cdn-food-icon.coachlink.fit
# TARO_APP_RECENT_REQUEST_TRACE_LIMIT=50
