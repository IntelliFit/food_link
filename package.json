{
  "name": "food_link",
  "version": "3.0.2",
  "private": true,
  "description": "AI Food Analysis and Diet Sharing Community",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "postinstall": "patch-package",
    "new": "npm --workspace apps/wechat run new",
    "lint": "npm --workspace apps/wechat run lint",
    "typecheck": "npm --workspace apps/wechat run typecheck",
    "dev:backend": "cross-env NODE_ENV=development node scripts/run-backend.cjs",
    "stop:backend": "node scripts/stop-backend.cjs",
    "dev:restart": "bash scripts/restart-dev.sh",
    "test": "npm --workspace apps/wechat run test",
    "test:watch": "npm --workspace apps/wechat run test:watch",
    "test:coverage": "npm --workspace apps/wechat run test:coverage",
    "test:backend": "cd backend && source venv/bin/activate && pytest",
    "test:backend:coverage": "cd backend && source venv/bin/activate && pytest --cov=. --cov-report=html",
    "test:backend:api-contract": "cd backend && go run ./e2e-test/cmd/api-contract-test",
    "test:e2e-weapp": "cd e2e-weapp && npx ts-node src/runner.ts --scenario scenarios/home-dashboard.yaml",
    "test:e2e-weapp:smoke": "cd e2e-weapp && npx ts-node src/runner.ts --scenario scenarios/smoke.yaml",
    "test:e2e-weapp:traces": "cd e2e-weapp && npx ts-node src/trace-runner.ts --traces traces/analyze-food.yaml",
    "dev:website": "cd website && npm run dev",
    "build:website": "cd website && npm run build",
    "preview:website": "cd website && npm run preview",
    "build:weapp": "npm --workspace apps/wechat run build:weapp",
    "build:weapp:preview": "npm --workspace apps/wechat run build:weapp:preview",
    "build:weapp:release": "npm --workspace apps/wechat run build:weapp:release",
    "build:weapp:debug": "npm --workspace apps/wechat run build:weapp:debug",
    "build:weapp:e2e": "npm --workspace apps/wechat run build:weapp:e2e",
    "build:swan": "npm --workspace apps/wechat run build:swan",
    "build:alipay": "npm --workspace apps/wechat run build:alipay",
    "build:tt": "npm --workspace apps/wechat run build:tt",
    "build:h5": "npm --workspace apps/wechat run build:h5",
    "build:rn": "npm --workspace apps/wechat run build:rn",
    "build:qq": "npm --workspace apps/wechat run build:qq",
    "build:jd": "npm --workspace apps/wechat run build:jd",
    "build:harmony-hybrid": "npm --workspace apps/wechat run build:harmony-hybrid",
    "dev:weapp": "npm --workspace apps/wechat run dev:weapp",
    "dev:weapp:preview": "npm --workspace apps/wechat run dev:weapp:preview",
    "dev:weapp:online": "npm --workspace apps/wechat run dev:weapp:online",
    "dev:mobile": "node scripts/start-mobile-dev.cjs",
    "typecheck:mobile": "npm --workspace apps/mobile run typecheck",
    "build:mobile:ios:preview": "npm --workspace apps/mobile run build:ios:preview",
    "build:mobile:ios:production": "npm --workspace apps/mobile run build:ios:production",
    "release:mobile:android": "python scripts/release_mobile_android.py",
    "dev:swan": "npm --workspace apps/wechat run dev:swan",
    "dev:alipay": "npm --workspace apps/wechat run dev:alipay",
    "dev:tt": "npm --workspace apps/wechat run dev:tt",
    "dev:h5": "npm --workspace apps/wechat run dev:h5",
    "dev:rn": "npm --workspace apps/wechat run dev:rn",
    "dev:qq": "npm --workspace apps/wechat run dev:qq",
    "dev:jd": "npm --workspace apps/wechat run dev:jd",
    "dev:harmony-hybrid": "npm --workspace apps/wechat run dev:harmony-hybrid",
    "iconfont": "npm --workspace apps/wechat run iconfont",
    "push-docker-ccr": "node backend/scripts/push-docker-ccr.mjs",
    "debug:feedback-samples": "bash scripts/query-analysis-feedback-samples.sh",
    "nutrition:enrich-missing": "python scripts/enrich_missing_nutrients.py",
    "nutrition:enrich-packaged": "python scripts/enrich_packaged_foods.py"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@taroify/core": "^0.8.0",
    "@taroify/icons": "^0.8.0",
    "@tarojs/components": "4.1.10",
    "@tarojs/helper": "4.1.10",
    "@tarojs/plugin-framework-react": "4.1.10",
    "@tarojs/plugin-platform-alipay": "4.1.10",
    "@tarojs/plugin-platform-h5": "4.1.10",
    "@tarojs/plugin-platform-harmony-hybrid": "4.1.10",
    "@tarojs/plugin-platform-jd": "4.1.10",
    "@tarojs/plugin-platform-qq": "4.1.10",
    "@tarojs/plugin-platform-swan": "4.1.10",
    "@tarojs/plugin-platform-tt": "4.1.10",
    "@tarojs/plugin-platform-weapp": "4.1.10",
    "@tarojs/react": "4.1.10",
    "@tarojs/runtime": "4.1.10",
    "@tarojs/shared": "4.1.10",
    "@tarojs/taro": "4.1.10",
    "@vant/area-data": "^2.1.0",
    "echarts": "^5.6.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "taro-plugin-canvas": "^1.0.10",
    "vant-weapp": "^0.5.29",
    "weapp-qrcode-canvas-2d": "^1.1.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tarojs/cli": "4.1.10",
    "@tarojs/plugin-generator": "4.1.10",
    "@tarojs/vite-runner": "4.1.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5",
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "babel-preset-taro": "4.1.10",
    "consola": "^3.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.1.10",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.1.2",
    "miniprogram-automator": "^0.12.1",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "sharp": "^0.34.5",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "taro-iconfont-cli": "^3.3.0",
    "terser": "^5.30.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.4.5",
    "vite": "^4.2.0",
    "vite-plugin-style-import": "^2.0.0"
  }
}
