# 复制为 admin/.env.development 或 admin/.env.production（本地开发用）
# Cloudflare Pages 请在项目 Settings → Environment variables 配置同名变量
# 详见 docs/api-url-configuration.md

# 开发 / Preview 部署示例
VITE_ADMIN_API_BASE_URL=https://dev.api.healthymax.cn

# Production 部署（Cloudflare Pages Production 环境）示例：
# VITE_ADMIN_API_BASE_URL=https://api.healthymax.cn

# 若通过反代使 Admin 与 API 同源，可留空
