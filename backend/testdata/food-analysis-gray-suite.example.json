          }
        ],
        "expect": {
          "require_done": true,
          "require_ai_ratio": true,
          "min_items": 1,
          "name_contains": [
            "半包"
          ],
          "item_expectations": [
            {
              "name_contains": [
                "半包"
              ],
              "min_weight_g": 52,
              "max_weight_g": 53,
              "min_calories": 52,
              "max_calories": 53,
              "nutrition_source": "user_correction_context",
