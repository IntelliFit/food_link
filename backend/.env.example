# Required. No default is applied.
# local: read all runtime config from app-config.yaml.
# apollo: read Apollo bootstrap from apollo-config.yaml, then fetch all
# runtime business config from Apollo.
CONFIG_SOURCE=local

# 意见反馈飞书机器人（可选；也可写在 app-config.yaml 的 feishu 节）
# FEISHU_FEEDBACK_WEBHOOK_URL=
# FEISHU_FEEDBACK_WEBHOOK_SECRET=

# 圈子动态举报飞书机器人（可选；也可写在 app-config.yaml 的 feishu 节）
# FEISHU_REPORT_WEBHOOK_URL=
# FEISHU_REPORT_WEBHOOK_SECRET=

# DashScope / 通义千问（标准食物图片回填 CLI 视觉判定，勿提交真实 Key）
DASHSCOPE_API_KEY=
# 可选：国际区用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1