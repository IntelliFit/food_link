# Required. No default is applied.
# local: read all runtime config from app-config.yaml.
# apollo: read Apollo bootstrap from apollo-config.yaml, then fetch all
# runtime business config from Apollo.
CONFIG_SOURCE=local

# npm run dev:backend 强制设为 1；只禁用 worker，不改变数据库或 API 配置。
# Apollo local 环境无论配置了多少 worker，也会自动禁用。
# FOODLINK_DISABLE_WORKERS=1

# 意见反馈飞书机器人（可选；也可写在 app-config.yaml 的 feishu 节）
# FEISHU_FEEDBACK_WEBHOOK_URL=
# FEISHU_FEEDBACK_WEBHOOK_SECRET=

# 圈子动态举报飞书机器人（可选；也可写在 app-config.yaml 的 feishu 节）
# FEISHU_REPORT_WEBHOOK_URL=
# FEISHU_REPORT_WEBHOOK_SECRET=

# DashScope / 通义千问（快速模式、精准模式回退及营养补全等场景；勿提交真实 Key）
DASHSCOPE_API_KEY=
# 本项目 Qwen 统一通过万界方舟 OpenAI-compatible 网关调用，不改为百炼官方直连
# DASHSCOPE_BASE_URL=https://maas-openapi.wanjiedata.com/api/v1
# 旧兼容字段；普通模式主识别固定 Gemini，且 Gemini 失败时不回退 Qwen。
# QWEN38_ORDINARY_TRAFFIC_PERCENT=50

# Gemini OpenLux 上游（密钥勿提交；生产请放 Apollo）
# 下列比例只决定首选上游；即使设为 0，主源 10 秒未返回有效结果时仍可能调用 OpenLux 对冲。
# OPENLUX_API_KEY=
# OPENLUX_BASE_URL=https://api.openlux.ai/v1
# 普通模式把 OpenLux 作为首选上游的稳定比例。
# OPENLUX_ORDINARY_GEMINI_TRAFFIC_PERCENT=50
# 精准模式把 OpenLux Gemini 3.6 Flash 作为首选上游的稳定比例。
# OPENLUX_PRECISION_GEMINI_TRAFFIC_PERCENT=50
